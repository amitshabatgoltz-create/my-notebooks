rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // כל משתמש יכול לקרוא ולכתוב רק את המחברות והיומן של עצמו
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // הכול חוץ מהמונה של ה-AI (שלו יש כללים משלו למטה)
      allow write: if request.auth != null && request.auth.uid == userId
        && request.path != /databases/$(database)/documents/users/$(userId)/meta/usage;
    }
    // 🔒 המכסה היומית של ה-AI: המונה יכול רק לעלות. אי אפשר לאפס, למחוק או לקפוץ ליום אחר כדי לקבל עוד.
    // day = מספר הימים מ-1970 לפי שעון ישראל. השרת בודק שהוא לא אחרי היום של היום.
    match /users/{userId}/meta/usage {
      function counters() { return ['ocr', 'sum', 'qa', 'fc', 'chat', 'cf', 'kit', 'pr', 'wr']; }
      function today() { return math.floor((request.time.toMillis() + 10800000) / 86400000); }
      function n(d, k) { return d.get(k, 0); }
      function validNew() {
        let d = request.resource.data;
        return d.keys().hasOnly(['date', 'day'].concat(counters()))
          && d.day is int && d.day <= today() && d.day >= today() - 1
          && d.date is string && d.date.size() <= 10
          && n(d, 'ocr') is int && n(d, 'sum') is int && n(d, 'qa') is int && n(d, 'fc') is int
          && n(d, 'chat') is int && n(d, 'cf') is int && n(d, 'kit') is int && n(d, 'pr') is int && n(d, 'wr') is int;
      }
      function noneDown() {
        let a = request.resource.data; let b = resource.data;
        return n(a, 'ocr') >= n(b, 'ocr') && n(a, 'sum') >= n(b, 'sum') && n(a, 'qa') >= n(b, 'qa') && n(a, 'fc') >= n(b, 'fc')
          && n(a, 'chat') >= n(b, 'chat') && n(a, 'cf') >= n(b, 'cf') && n(a, 'kit') >= n(b, 'kit') && n(a, 'pr') >= n(b, 'pr') && n(a, 'wr') >= n(b, 'wr');
      }
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && validNew();
      allow update: if request.auth != null && request.auth.uid == userId && validNew()
        && (!('day' in resource.data) || request.resource.data.day > resource.data.day
            || (request.resource.data.day == resource.data.day && noneDown()));
      allow delete: if false;
    }
    // תמונה אחת לפי הקוד שלה: כדי שחברים יראו תמונות במחברת ששיתפת (אי אפשר לקבל רשימה של כל התמונות)
    match /users/{userId}/images/{imageId} {
      allow get: if true;
    }
    // קבצים מצורפים: כמו תמונות, אפשר לפתוח קובץ אחד לפי הקוד שלו (בשביל מחברות משותפות)
    match /users/{userId}/files/{fileId} {
      allow get: if true;
      match /chunks/{chunkId} {
        allow get: if true;
      }
    }
    // 📊 ניהול האתר: כל משתמש כותב רק את הסטטיסטיקה של עצמו, ורק בעל האתר רואה את כולם.
    // את הקטע עם הקוד של בעל האתר מעתיקים מהעמוד "ניהול האתר" באתר (ADMIN_UID מוחלף שם בקוד האמיתי)
    match /stats/{uid} {
      allow read: if request.auth != null && request.auth.token.email == 'amitshabatgoltz@gmail.com';
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'first', 'last', 'lastDay', 'nb', 'device', 'ai', 'ref'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 100))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() < 200))
        && (!('device' in request.resource.data) || (request.resource.data.device is string && request.resource.data.device.size() < 40))
        && (!('nb' in request.resource.data) || request.resource.data.nb is int)
        && (!('ai' in request.resource.data) || request.resource.data.ai is map)
        && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.size() < 60));
    }
    // הזמנת חברים: refs/<מי שהזמין>/joined/<החבר החדש>. רק משתמש חדש (שעוד אין לו stats) יכול להירשם כחבר, פעם אחת.
    // מי שהזמין רואה רק את החברים שלו, ובעל האתר רואה הכול
    match /refs/{refUid}/joined/{newUid} {
      allow read: if request.auth != null && (request.auth.uid == refUid || request.auth.token.email == 'amitshabatgoltz@gmail.com');
      allow create: if request.auth != null && request.auth.uid == newUid && newUid != refUid
        && !exists(/databases/$(database)/documents/stats/$(newUid))
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() < 100
        && request.resource.data.at is int;
      allow update, delete: if false;
    }
    // 🔒 ספירת ה-AI: רק השרת כותב. בעל האתר יכול לקרוא את הספירה של כל האתר (aiQuota/_site) בעמוד "ניהול האתר"
    match /aiQuota/{id} {
      allow get: if id == '_site' && request.auth != null && request.auth.token.email == 'amitshabatgoltz@gmail.com';
    }
    // מחברות משותפות: מי שיש לו את הקישור יכול לקרוא, ורק מי ששיתף יכול לשנות או לבטל.
    // בעריכה משותפת, כל מי שמחובר יכול לשנות רק את התוכן (לא את הבעלים ולא את סוג השיתוף)
    match /shares/{shareId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner)
        || (resource.data.mode == 'edit'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['html', 'title', 'updatedAt', 'updatedBy', 'updatedByName'])
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.html.size() < 900000)
      );
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      // מי נמצא עכשיו במחברת
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
